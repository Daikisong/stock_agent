{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2r.local/schema/e2r_pro_repair_delta_v3.schema.json",
  "title": "E2R Pro Compact Repair Delta V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "research_pass_id",
    "parent_pass_id",
    "target",
    "as_of_date",
    "repair_actions",
    "new_source_documents",
    "new_route_receipts",
    "score_authority",
    "stage_authority"
  ],
  "properties": {
    "schema_version": {"const": "e2r_pro_repair_delta_v3"},
    "job_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "research_pass_id": {"type": "string", "minLength": 1},
    "parent_pass_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "as_of_date": {"type": "string", "format": "date"},
    "repair_actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repairAction"}
    },
    "new_source_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceDocument"}
    },
    "new_route_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/searchRouteReceipt"}
    },
    "score_authority": {"const": false},
    "stage_authority": {"const": false}
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "company_name", "aliases"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "symbol": {"type": "string"},
        "company_name": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "componentId": {
      "enum": [
        "eps_fcf_explosion",
        "earnings_visibility",
        "bottleneck_pricing",
        "market_mispricing",
        "valuation_rerating",
        "capital_allocation",
        "information_confidence"
      ]
    },
    "verifierPreflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_opened",
        "canonical_url_used",
        "exact_excerpt_copied_from_source",
        "statement_not_broader_than_excerpt",
        "single_atomic_predicate",
        "target_subject_scope_confirmed",
        "publication_date_confirmed",
        "as_of_cutoff_pass",
        "lineage_duplicate_checked",
        "derived_calculation_mixed_into_fact"
      ],
      "properties": {
        "source_opened": {"const": true},
        "canonical_url_used": {"const": true},
        "exact_excerpt_copied_from_source": {"const": true},
        "statement_not_broader_than_excerpt": {"const": true},
        "single_atomic_predicate": {"const": true},
        "target_subject_scope_confirmed": {"const": true},
        "publication_date_confirmed": {"const": true},
        "as_of_cutoff_pass": {"const": true},
        "lineage_duplicate_checked": {"const": true},
        "derived_calculation_mixed_into_fact": {"const": false}
      }
    },
    "targetScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "issuer_scoped",
        "subject",
        "business_segment",
        "product_family"
      ],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "issuer_scoped": {"type": "boolean"},
        "subject": {"type": "string", "minLength": 1},
        "business_segment": {"type": "string", "minLength": 1},
        "product_family": {"type": "string", "minLength": 1}
      }
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_document_id",
        "canonical_url",
        "opened_url",
        "source_title",
        "source_publisher",
        "publication_date",
        "availability_date",
        "source_role_ids",
        "document_type",
        "target_scope",
        "locator_type",
        "locator_value",
        "lineage_id",
        "opened_and_read",
        "as_of_cutoff_pass"
      ],
      "properties": {
        "source_document_id": {
          "type": "string",
          "pattern": "^(SRC|PROSRC)-[A-Za-z0-9._:-]+$"
        },
        "canonical_url": {"type": "string", "format": "uri"},
        "opened_url": {"type": "string", "format": "uri"},
        "source_title": {"type": "string", "minLength": 1},
        "source_publisher": {"type": "string", "minLength": 1},
        "publication_date": {"type": "string", "format": "date"},
        "availability_date": {"type": "string", "format": "date"},
        "source_role_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "document_type": {
          "enum": ["HTML", "PDF", "FILING", "IR", "NEWS", "MARKET_DATA", "DATASET"]
        },
        "target_scope": {"$ref": "#/$defs/targetScope"},
        "locator_type": {
          "enum": ["HTML_HEADING", "HTML_PARAGRAPH", "PDF_PAGE", "TABLE", "FILING_SECTION"]
        },
        "locator_value": {"type": "string", "minLength": 1},
        "lineage_id": {"type": "string", "pattern": "^(SL|LINEAGE)-[A-Za-z0-9._:-]+$"},
        "opened_and_read": {"const": true},
        "as_of_cutoff_pass": {"const": true}
      }
    },
    "atomicFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dossier_fact_id",
        "research_pass_id",
        "fact_kind",
        "statement",
        "predicate_id",
        "direction",
        "target_id",
        "subject",
        "issuer_scoped",
        "business_segment",
        "product_family",
        "economic_mechanism_id",
        "value",
        "unit",
        "period",
        "event_date",
        "current_status",
        "question_family_ids",
        "candidate_component_ids",
        "source_document_id",
        "supporting_excerpt",
        "source_locator",
        "confidence",
        "verifier_preflight"
      ],
      "properties": {
        "dossier_fact_id": {"type": "string", "pattern": "^(FACT|PROFACT)-[A-Za-z0-9._:-]+$"},
        "research_pass_id": {"type": "string", "minLength": 1},
        "fact_kind": {"enum": ["MATERIAL", "COUNTER", "RESOLUTION"]},
        "statement": {"type": "string", "minLength": 1},
        "predicate_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["POSITIVE", "NEGATIVE", "NEUTRAL", "RESOLUTION"]},
        "target_id": {"type": "string", "minLength": 1},
        "subject": {"type": "string", "minLength": 1},
        "issuer_scoped": {"type": "boolean"},
        "business_segment": {"type": "string", "minLength": 1},
        "product_family": {"type": "string", "minLength": 1},
        "economic_mechanism_id": {"type": "string", "minLength": 1},
        "value": {},
        "unit": {"type": ["string", "null"]},
        "period": {"type": ["string", "null"]},
        "event_date": {"type": ["string", "null"], "format": "date"},
        "current_status": {
          "enum": ["CURRENT", "OPEN", "RESOLVED", "SUPERSEDED", "HISTORICAL_ONLY"]
        },
        "question_family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "candidate_component_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/componentId"}
        },
        "source_document_id": {"type": "string", "minLength": 1},
        "supporting_excerpt": {"type": "string", "minLength": 8},
        "source_locator": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "verifier_preflight": {"$ref": "#/$defs/verifierPreflight"}
      }
    },
    "searchRouteReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route_receipt_id",
        "pass_id",
        "archetype_id",
        "question_family_id",
        "gap_id",
        "source_role_id",
        "query_or_navigation_objective",
        "query_text",
        "result_count_seen",
        "opened_source_urls",
        "accepted_fact_ids",
        "rejected_candidate_ids",
        "provider_status",
        "no_new_route_reason",
        "performed_at"
      ],
      "properties": {
        "route_receipt_id": {"type": "string", "minLength": 1},
        "pass_id": {"type": "string", "minLength": 1},
        "archetype_id": {"type": "string", "minLength": 1},
        "question_family_id": {"type": "string", "minLength": 1},
        "gap_id": {"type": ["string", "null"]},
        "source_role_id": {"type": "string", "minLength": 1},
        "query_or_navigation_objective": {"type": "string", "minLength": 1},
        "query_text": {"type": ["string", "null"]},
        "result_count_seen": {"type": "integer", "minimum": 0},
        "opened_source_urls": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "format": "uri"}
        },
        "accepted_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rejected_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "provider_status": {
          "enum": ["SUCCESS", "PROVIDER_PENDING", "PARSER_PENDING", "TRANSPORT_PENDING", "FAILED"]
        },
        "no_new_route_reason": {"type": ["string", "null"]},
        "performed_at": {"type": "string", "format": "date-time"}
      }
    },
    "repairAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "question_family_ids",
        "rejection_category",
        "original_statement",
        "source_document_id",
        "canonical_url",
        "fetched_excerpt",
        "allowed_action",
        "action",
        "replacement_source_document",
        "replacement_fact",
        "reason"
      ],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "question_family_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rejection_category": {
          "enum": [
            "INITIAL_PROMPT_OUTPUT_DEFECT",
            "GENUINE_SEMANTIC_OR_SOURCE_DEFECT"
          ]
        },
        "original_statement": {"type": "string", "minLength": 1},
        "source_document_id": {"type": "string", "minLength": 1},
        "canonical_url": {"type": "string", "format": "uri"},
        "fetched_excerpt": {"type": "string"},
        "allowed_action": {"const": "CORRECT|REPLACE|NARROW|WITHDRAW"},
        "action": {"enum": ["CORRECT", "REPLACE", "NARROW", "WITHDRAW"]},
        "replacement_source_document": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sourceDocument"}
          ]
        },
        "replacement_fact": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/atomicFact"}
          ]
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
