{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2r.local/schemas/e2r_pro_research_packet_v3.schema.json",
  "title": "E2R Pro Fresh-Blind ResearchPacketV3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "target",
    "as_of_date",
    "latest_trading_snapshot_date",
    "research_mode",
    "trigger_summary",
    "candidate_archetypes",
    "selected_archetypes",
    "business_snapshot",
    "structured_financial_snapshot",
    "revision_valuation_snapshot",
    "research_objectives",
    "source_preferences",
    "forbidden_inferences",
    "initial_research_protocol",
    "research_contract_snapshot",
    "dossier_output_schema",
    "dossier_output_schema_hash",
    "fresh_blind_boundary",
    "output_contract",
    "score_authority",
    "stage_authority"
  ],
  "properties": {
    "schema_version": {"const": "e2r_pro_research_packet_v3"},
    "job_id": {"type": "string", "pattern": "^PROJOB-[A-Fa-f0-9]+$"},
    "run_id": {"type": "string", "pattern": "^PRORUN-[A-Fa-f0-9]+$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "symbol", "company_name", "aliases"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "aliases": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "as_of_date": {"type": "string", "format": "date"},
    "latest_trading_snapshot_date": {"type": "string", "format": "date"},
    "research_mode": {"enum": ["FULL_RESEARCH", "FORCED_VALIDATION_CANARY"]},
    "trigger_summary": {"type": "array", "items": {"type": "object"}},
    "candidate_archetypes": {"$ref": "#/$defs/archetypeRoster"},
    "selected_archetypes": {"$ref": "#/$defs/archetypeRoster"},
    "business_snapshot": {"type": "object"},
    "structured_financial_snapshot": {"type": "object"},
    "revision_valuation_snapshot": {"type": "object"},
    "research_objectives": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "source_preferences": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "forbidden_inferences": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "initial_research_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "instructions_markdown", "protocol_hash"],
      "properties": {
        "schema_version": {"const": "e2r_pro_initial_research_protocol_v3"},
        "instructions_markdown": {"type": "string", "minLength": 1},
        "protocol_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "research_contract_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_schema_version",
        "primary_archetype_ids",
        "contract_ids",
        "mandatory_question_ids",
        "contracts",
        "snapshot_hash"
      ],
      "properties": {
        "catalog_schema_version": {"const": "e2r_archetype_research_contracts_v2"},
        "primary_archetype_ids": {"$ref": "#/$defs/archetypeRoster"},
        "contract_ids": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "mandatory_question_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "object"}
        },
        "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "dossier_output_schema": {
      "type": "object",
      "required": ["$schema", "type", "properties", "required"]
    },
    "dossier_output_schema_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fresh_blind_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_pro_fact_input_count",
        "old_route_receipt_input_count",
        "old_rejection_input_count",
        "old_question_answer_input_count",
        "old_score_stage_input_count",
        "expected_source_input_count",
        "expected_fact_id_input_count"
      ],
      "properties": {
        "old_pro_fact_input_count": {"const": 0},
        "old_route_receipt_input_count": {"const": 0},
        "old_rejection_input_count": {"const": 0},
        "old_question_answer_input_count": {"const": 0},
        "old_score_stage_input_count": {"const": 0},
        "expected_source_input_count": {"const": 0},
        "expected_fact_id_input_count": {"const": 0}
      }
    },
    "output_contract": {"const": "e2r_pro_research_dossier_v3"},
    "score_authority": {"const": false},
    "stage_authority": {"const": false}
  },
  "$defs": {
    "archetypeRoster": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
