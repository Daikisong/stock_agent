{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e2r.local/schemas/e2r_pro_research_packet_v2.schema.json",
  "title": "E2R Pro ResearchPacketV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "target",
    "as_of_date",
    "latest_trading_snapshot_date",
    "research_mode",
    "trigger_summary",
    "candidate_archetypes",
    "business_snapshot",
    "structured_financial_snapshot",
    "revision_valuation_snapshot",
    "existing_thesis_digest",
    "historical_anchor_digest",
    "known_positive_facts",
    "known_counterfacts",
    "research_objectives",
    "source_preferences",
    "forbidden_inferences",
    "delta_context",
    "research_contract_snapshot",
    "output_contract",
    "score_authority",
    "stage_authority"
  ],
  "properties": {
    "schema_version": {"const": "e2r_pro_research_packet_v2"},
    "job_id": {"type": "string", "pattern": "^PROJOB-[A-Fa-f0-9]+$"},
    "run_id": {"type": "string", "pattern": "^PRORUN-[A-Fa-f0-9]+$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "company_name", "aliases"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "company_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "as_of_date": {"type": "string", "format": "date"},
    "latest_trading_snapshot_date": {"type": "string", "format": "date"},
    "research_mode": {
      "enum": ["FULL_RESEARCH", "DELTA_RESEARCH", "FORCED_VALIDATION_CANARY"]
    },
    "trigger_summary": {"type": "array", "items": {"type": "object"}},
    "candidate_archetypes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "business_snapshot": {"type": "object"},
    "structured_financial_snapshot": {"type": "object"},
    "revision_valuation_snapshot": {"type": "object"},
    "existing_thesis_digest": {"type": ["object", "null"]},
    "historical_anchor_digest": {"type": "array", "items": {"type": "object"}},
    "known_positive_facts": {"type": "array", "items": {"type": "object"}},
    "known_counterfacts": {"type": "array", "items": {"type": "object"}},
    "research_objectives": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_preferences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "forbidden_inferences": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "delta_context": {"type": ["object", "null"]},
    "research_contract_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_schema_version",
        "primary_archetype_ids",
        "contract_ids",
        "mandatory_question_ids",
        "contracts",
        "snapshot_hash"
      ],
      "properties": {
        "catalog_schema_version": {"const": "e2r_archetype_research_contracts_v2"},
        "primary_archetype_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "contract_ids": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "mandatory_question_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "contracts": {
          "type": "array",
          "minItems": 5,
          "items": {"type": "object"}
        },
        "snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "output_contract": {"const": "e2r_pro_research_dossier_v2"},
    "score_authority": {"const": false},
    "stage_authority": {"const": false}
  }
}
